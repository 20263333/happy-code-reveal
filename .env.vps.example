# Binosoz.tj — production environment for VPS
# Copy this file to /root/binosoz.env on the VPS and fill in real values.
# NEVER commit real secrets to git.

# Self-hosted backend (installed by scripts/vps-install.sh).
# Browser traffic uses the HTTPS Nginx proxy; server traffic stays local.
VITE_SUPABASE_URL=https://binosoz.tj/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key-from-/root/supabase-credentials.txt>
VITE_SUPABASE_PROJECT_ID=local

SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=<anon-key-from-/root/supabase-credentials.txt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-/root/supabase-credentials.txt>

# Auth / session
SESSION_SECRET=<generate-with-openssl-rand-base64-32>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Webhook / cron secrets
SMS_CRON_SECRET=<generate-random-string>
MARKETPLACE_SYNC_SECRET=<generate-random-string>

# AI Gateway (Lovable AI Gateway)
LOVABLE_AI_GATEWAY_KEY=
LOVABLE_API_KEY=

# OpenAI (аккаунти шахсии ChatGPT) — сканери паспорт, сканери склад ва ёрдамчии AI.
# Агар OPENAI_API_KEY пур бошад, ҳамаи ин қисмҳо маҳз аз ҳамин аккаунт кор мекунанд.
# AI_PROVIDER=openai|lovable — маҷбуран интихоб кардани провайдер (ихтиёрӣ).
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o-mini
OPENAI_OCR_MODEL_PRO=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MODEL_MINI=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# OSON SMS defaults (per-project overrides live in company_sms_settings)
OSON_SMS_BASE_URL=https://api.osonsms.com
OSON_SMS_LOGIN=
OSON_SMS_PASSWORD=
OSON_SMS_BRAND=

# Wappi.pro WhatsApp
WAPPI_API_KEY=
WAPPI_API_URL=https://wappi.pro

# Paddle / Stripe (if used)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server binding
VITE_SITE_URL=https://binosoz.tj
SUPABASE_PUBLIC_URL=https://binosoz.tj
PORT=3000
APP_PORT=3000
NODE_ENV=production

# Шарики фурӯш — deploy-vps.sh барои арзишҳои холӣ танзимоти қабулкунандаро
# худкор мегузорад. Танҳо агар қабулкунанда иваз шавад, инҳоро пур кунед.
SALES_PARTNER_WEBHOOK_URL=
SALES_PARTNER_WEBHOOK_SECRET=
